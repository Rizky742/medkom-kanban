# Copy file ini menjadi `.env` lalu isi URL Web app dari Apps Script Deploy.
VITE_API_URL=https://script.google.com/macros/s/XXXX/exec
# Opsional (disarankan untuk production):
# - Ganti PIN bawaan tanpa commit ke repo (set juga di Vercel > Settings > Environment Variables)
# VITE_ADMIN_PIN=6-digit-rahasia-admin
# VITE_MEMBER_PIN=6-digit-rahasia-anggota
# - Kunci tulis backend: harus sama dengan ScriptProperties WRITE_KEY di Apps Script.
#   Kalau WRITE_KEY diset di backend tapi VITE_WRITE_KEY kosong, aksi tulis ditolak.
# VITE_WRITE_KEY=isi-random-panjang
